            ]
          },
          "docs": "Get contact counts by intent type"
        },
        {
          "info": {
            "name": "Enrich a contact's email",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/contact/:id/enrich/email",
            "headers": [
              {
                "name": "x-impersonate-user-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Attempts to find a verified email for the given contact. Each email enrichment that returns an email consumes 1 credit; failed enrichments do not consume any credit."
        }
      ]
